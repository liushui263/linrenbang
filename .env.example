# 复制成 .env.local（本地）或填进 Vercel → Settings → Environment Variables
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 只在服务端用，绝不进前端、不要发到群里
SUPABASE_SERVICE_ROLE_KEY=
# 站长的 Supabase 用户 id（用 Google 登录一次后，在 Supabase → Authentication → Users 里复制），多个用逗号隔开
ADMIN_USER_IDS=
# 网站正式地址（用于微信分享卡片）
NEXT_PUBLIC_SITE_URL=https://linrenbang.com
# 选填：联系方式限流用的 IP 哈希盐，随便填一串字符
CONTACT_HASH_SALT=
# 选填：Supabase 里配好 Apple 登录后设为 1，登录页才出现“通过 Apple 登录”按钮
NEXT_PUBLIC_AUTH_APPLE=
